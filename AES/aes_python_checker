#!/usr/bin/env python3
"""
verify_aes6_vivado.py

Verify AES-6-round output for the aeslite Vivado project.
This script computes AES-128 encryption for 6 rounds using the exact
SubBytes, ShiftRows, MixColumns, and key expansion semantics used by
aeslite_pipeline.v.

Usage:
  python verify_aes6_vivado.py --plaintext 00112233445566778899aabbccddeeff \
      --key 000102030405060708090a0b0c0d0e0f

  python verify_aes6_vivado.py --plaintext 00112233445566778899aabbccddeeff \
      --key 000102030405060708090a0b0c0d0e0f --vivado d84ee7c591058c94047ce1a90a7d0e30

If no arguments are provided, the script prints two known test vectors.
"""

import argparse
import textwrap

SBOX = [
    0x63,0x7c,0x77,0x7b,0xf2,0x6b,0x6f,0xc5,0x30,0x01,0x67,0x2b,0xfe,0xd7,0xab,0x76,
