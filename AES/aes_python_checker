]
RCON = [0x00, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20]


def hex_to_bytes(hex_str: str) -> bytes:
    hex_str = hex_str.strip().replace('0x', '').replace('_', '')
    if len(hex_str) != 32:
        raise ValueError('Expected 32 hex characters for 128-bit data')
    return bytes.fromhex(hex_str)


def bytes_to_hex(data: bytes) -> str:
    return data.hex()


def subbytes(state: bytes) -> bytes:
    return bytes(SBOX[b] for b in state)


def shiftrows(state: bytes) -> bytes:
    # Matches the Verilog shiftrows.v ordering on a 128-bit big-endian state
    order = [
        0, 5, 10, 15,
        4, 9, 14, 3,
        8, 13, 2, 7,
        12, 1, 6, 11,
    ]
    return bytes(state[i] for i in order)


def xtime(b: int) -> int:
    return ((b << 1) ^ 0x1B) & 0xFF if (b & 0x80) else (b << 1)


def mixcolumns(state: bytes) -> bytes:
    # Verilog mixcolumns uses each 32-bit word as a column in big-endian order.
    out = bytearray(16)
    for col in range(4):
        base = col * 4
        s0 = state[base + 0]
        s1 = state[base + 1]
        s2 = state[base + 2]
        s3 = state[base + 3]

        out[base + 0] = xtime(s0) ^ (xtime(s1) ^ s1) ^ s2 ^ s3
        out[base + 1] = s0 ^ xtime(s1) ^ (xtime(s2) ^ s2) ^ s3
        out[base + 2] = s0 ^ s1 ^ xtime(s2) ^ (xtime(s3) ^ s3)
        out[base + 3] = (xtime(s0) ^ s0) ^ s1 ^ s2 ^ xtime(s3)
    return bytes(out)


def expand_key(key: bytes) -> list[bytes]:
    if len(key) != 16:
        raise ValueError('Key must be 16 bytes')
    w = [key[i:i+4] for i in range(0, 16, 4)]
    for i in range(4, 28):
        temp = w[i - 1]
        if i % 4 == 0:
            temp = bytes(a ^ b for a, b in zip(
                bytes(SBOX[b] for b in temp[1:] + temp[:1]),
                bytes([RCON[i // 4], 0, 0, 0])
            ))
        w.append(bytes(a ^ b for a, b in zip(w[i - 4], temp)))
    return [b''.join(w[4*i:4*i+4]) for i in range(7)]


def aes6_encrypt(plaintext: bytes, key: bytes) -> bytes:
    round_keys = expand_key(key)
    state = bytes(a ^ b for a, b in zip(plaintext, round_keys[0]))
    for rnd in range(1, 6):
        state = subbytes(state)
        state = shiftrows(state)
        state = mixcolumns(state)
        state = bytes(a ^ b for a, b in zip(state, round_keys[rnd]))
    state = subbytes(state)
    state = shiftrows(state)
    state = bytes(a ^ b for a, b in zip(state, round_keys[6]))
    return state


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description='Verify AES-6-round output for the Vivado aeslite project.',
        formatter_class=argparse.RawTextHelpFormatter,
    )
    parser.add_argument('--plaintext', '-p', help='128-bit plaintext hex (32 hex chars)')
    parser.add_argument('--key', '-k', help='128-bit key hex (32 hex chars)')
    parser.add_argument('--vivado', '-v', help='Vivado ciphertext hex to compare')
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    if not args.plaintext or not args.key:
        print('No plaintext/key provided. Showing known test vectors:')
        examples = [
            ('00112233445566778899aabbccddeeff', '000102030405060708090a0b0c0d0e0f'),
            ('112233445566778899aabbccddeeff00', '000102030405060708090a0b0c0d0e0f'),
        ]
        for pt_hex, key_hex in examples:
            pt = hex_to_bytes(pt_hex)
            key = hex_to_bytes(key_hex)
            out = aes6_encrypt(pt, key)
            print(f'plaintext = {pt_hex}')
            print(f'key       = {key_hex}')
            print(f'expected  = {bytes_to_hex(out)}\n')
        return

    plaintext = hex_to_bytes(args.plaintext)
    key = hex_to_bytes(args.key)
    expected = aes6_encrypt(plaintext, key)
    print(f'plaintext = {args.plaintext}')
    print(f'key       = {args.key}')
    print(f'expected  = {bytes_to_hex(expected)}')

    if args.vivado:
        vivado = args.vivado.strip().replace('0x', '').replace('_', '')
        print(f'vivado    = {vivado}')
        if vivado.lower() == bytes_to_hex(expected):
            print('match     = YES')
        else:
            print('match     = NO')
            print(f'expected  = {bytes_to_hex(expected)}')


if __name__ == '__main__':
    main()
